{
  "name": "08 · Re-order nudges for quiet customers",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * 1"
            }
          ]
        }
      },
      "id": "6c2e9f26-ee79-4f08-bf61-30d395e7ad6a",
      "name": "Mondays 10:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "customer_stats",
        "returnAll": true,
        "filterType": "string",
        "filterString": "=days_since_order=gte.45&days_since_order=lte.120&segment=neq.corporate&consent_whatsapp=eq.true"
      },
      "id": "10450fc3-1e60-4188-bbf9-facfdbc687ae",
      "name": "Quiet 45-120 days, opted in",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "36056f19-52aa-439b-ac62-cc64a9c4a1a0",
              "leftValue": "={{ $json.id !== undefined }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d9f55406-ed6f-4f31-9196-d42e0566345d",
      "name": "Anyone?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {},
      "id": "ac4d5f0a-44a6-4b3b-882d-e7cdcdd75a38",
      "name": "Nobody to nudge",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"claude-sonnet-5-5\", max_tokens: 200, temperature: 0.8, system: \"Write one short, warm WhatsApp message (max 35 words) from Koretbakes inviting a past customer to order again. Mention their last order by name. No discounts, no em dashes. End with: Reply YES and Tia will sort it.\", messages: [{ role: \"user\", content: \"Name: \" + $json.first_name + \". Last order: \" + $json.last_item + \". New this month: \" + $vars.NEW_THIS_MONTH }] }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "7079e3ef-6436-495e-be38-faf9610b36aa",
      "name": "Claude: personal nudge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        -60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: Anthropic API key (x-api-key)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const t = $json.content?.[0]?.text?.trim() ?? \"\";\nconst ok = t.length > 10 && t.length < 300 && !/—|–|discount|% off/i.test(t);\nreturn [{ json: { ...$(\"Quiet 45-120 days, opted in\").item.json, text: ok ? t : null, needs_review: !ok } }];"
      },
      "id": "31f8e1f3-c8aa-4cad-aba0-92c97e9c7c5b",
      "name": "Check message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -60
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "ccdf0f01-fa4c-4796-858a-ba5b785c38bb",
              "leftValue": "={{ $json.text !== null }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5a039b2c-cc02-4b6c-9024-f7fccd32fafc",
      "name": "Message OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1200,
        -60
      ]
    },
    {
      "parameters": {},
      "id": "824e5588-5eee-4b36-9f47-e4b2d6093d74",
      "name": "Held for review (bad AI output)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1440,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $vars.WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: \"whatsapp\", to: $json.phone, type: \"text\", text: { body: $json.text } }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "db3b44a5-b4f7-4a2a-aa1a-aabb47cd8a07",
      "name": "Send nudge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        -140
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: WhatsApp Cloud API token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Writes one row to automation_events (feeds the dashboard timeline and hours-saved KPI)\nreturn $input.all().map((i) => ({ json: {\n  workflow: \"reorder-nudge\",\n  title: \"Re-order nudge sent\",\n  contact_id: i.json.contact_id ?? i.json.id ?? null,\n  minutes_saved: 4,\n  at: new Date().toISOString(),\n} }));"
      },
      "id": "e33ef263-90bc-4f0b-ac06-385127225d9d",
      "name": "Log nudge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        -140
      ]
    }
  ],
