{
  "name": "04 · Payments: Paystack webhook, balance reminders",
  "nodes": [
    {
      "parameters": {
        "content": "## Payments\n**A.** Paystack webhook (signature verified) marks deposit or balance paid and confirms on WhatsApp. Only the webhook changes payment status, never the customer.\n**B.** Every morning, orders due within 48h with a balance get a reminder and pay link.",
        "width": 600,
        "height": 220,
        "color": 4
      },
      "id": "72352d73-b4c5-4340-98f1-66702c78da72",
      "name": "Note e83a",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -120,
        -320
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "paystack",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "70b79399-c2cd-41c6-b5b5-96e2333ed668",
      "name": "Webhook: Paystack charge.success",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "e3df8622-0168-4970-b6be-15370cb12147"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require(\"crypto\");\nconst sig = $json.headers[\"x-paystack-signature\"];\nconst hash = crypto.createHmac(\"sha512\", $vars.PAYSTACK_SECRET).update(JSON.stringify($json.body)).digest(\"hex\");\nif (hash !== sig) return [{ json: { valid: false } }];\nconst d = $json.body.data;\nreturn [{ json: { valid: $json.body.event === \"charge.success\", reference: d.reference, amount_ngn: d.amount / 100, number: d.reference.split(\"-\")[0] + \"-\" + d.reference.split(\"-\")[1], kind: d.reference.endsWith(\"-dep\") ? \"deposit\" : \"balance\" } }];"
      },
      "id": "ca39824e-b597-4fee-bf7a-afb3cab8d058",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "ecea201d-5ec7-4e5c-a9e6-34116211f22c",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "fc0e0a9f-abd2-4b38-9754-4846df3dc73c",
      "name": "Valid payment?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: false } }}",
        "options": {}
      },
      "id": "8b14a82b-3b93-47ac-896b-caf97f67a408",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        160
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "orders",
        "returnAll": true,
        "filterType": "string",
        "filterString": "=number=eq.{{ $json.number }}"
      },
      "id": "f30c6e59-7fb8-4aeb-9dde-ccabebbec227",
      "name": "Load order",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        720,
        -100
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const p = $(\"Verify signature\").first().json;\nconst paid = Number($json.paid_ngn) + p.amount_ngn;\nreturn [{ json: { id: $json.id, paid_ngn: paid, payment_status: paid >= $json.total_ngn ? \"paid\" : \"deposit\", status: $json.status === \"quoted\" ? \"confirmed\" : $json.status, phone: $json.phone, number: $json.number, balance: Math.max(0, $json.total_ngn - paid) } }];"
      },
      "id": "36d4e56a-6e52-4d79-a2aa-0a9531a3898e",
      "name": "Apply payment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -100
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "orders",
        "filterType": "string",
        "filterString": "=id=eq.{{ $json.id }}",
        "dataToSend": "autoMapInputData"
      },
      "id": "5d4c969b-a53d-45ad-acf8-50c1ab2ed6bf",
      "name": "Update order",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1200,
        -100
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $vars.WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: \"whatsapp\", to: $(\"Apply payment\").first().json.phone, type: \"text\", text: { body: `Payment received, thank you! ${$(\"Apply payment\").first().json.number} is confirmed. ${$(\"Apply payment\").first().json.balance ? \"Balance of ₦\" + $(\"Apply payment\").first().json.balance.toLocaleString() + \" is due before dispatch.\" : \"Paid in full.\"} Track it: https://koretbakes.ng/track/${$(\"Apply payment\").first().json.number}` } }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "c88e7841-ebad-4b47-b3bb-5f9b0442038d",
      "name": "Confirm on WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        -100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: WhatsApp Cloud API token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true } }}",
        "options": {}
      },
      "id": "e50194d7-c6ff-4404-90a5-88f8f08404ca",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1680,
        -100
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "cbf2fd91-d70b-437d-9aa0-0baf29432c5c",
      "name": "Daily 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        360
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "orders",
        "returnAll": true,
        "filterType": "string",
        "filterString": "=payment_status=eq.deposit&due_date=lte.{{ $now.plus({ days: 2 }).toFormat('yyyy-LL-dd') }}&due_date=gte.{{ $now.toFormat('yyyy-LL-dd') }}"
      },
      "id": "3c5a1c29-f7d2-4a61-b982-2d925dda4897",
      "name": "Balances due in 48h",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        240,
        360
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "b68aef49-8098-4864-85ef-5bdf4df4c7e2",
              "leftValue": "={{ $json.id !== undefined }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5aa875ed-8b20-44ff-9d33-0de72eb0fb75",
      "name": "Any due?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        360
      ]
    },
    {
      "parameters": {},
      "id": "cdc51461-fbf7-41d7-b09c-24bf23a5f26d",
      "name": "No balances due",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        480
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.paystack.co/transaction/initialize",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $json.email || ($json.phone.replace(\"+\", \"\") + \"@wa.koretbakes.ng\"), amount: ($json.total_ngn - $json.paid_ngn) * 100, reference: $json.number + \"-bal\", currency: \"NGN\", callback_url: \"https://koretbakes.ng/track/\" + $json.number + \"-bal\".split(\"-dep\")[0] }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "073fa19f-6c01-424d-8414-df62548fdcaa",
      "name": "Paystack: balance link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: Paystack secret key (Authorization: Bearer)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $vars.WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: \"whatsapp\", to: $(\"Balances due in 48h\").item.json.phone, type: \"text\", text: { body: `Hi! Your ${$(\"Balances due in 48h\").item.json.number} is scheduled for ${$(\"Balances due in 48h\").item.json.due_date}. The balance is due before dispatch: ${$json.data.authorization_url}` } }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "2905b1ff-972d-4282-b6e5-c566051b4f08",
      "name": "Balance reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: WhatsApp Cloud API token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Writes one row to automation_events (feeds the dashboard timeline and hours-saved KPI)\nreturn $input.all().map((i) => ({ json: {\n  workflow: \"payment-reminders\",\n  title: \"Balance reminder sent\",\n  contact_id: i.json.contact_id ?? i.json.id ?? null,\n  minutes_saved: 3,\n  at: new Date().toISOString(),\n} }));"
      },
      "id": "c73cff12-5e74-430d-ac86-43f7237b2df7",
      "name": "Log reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    }
  ],
