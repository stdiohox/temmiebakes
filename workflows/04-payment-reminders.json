{
  "name": "04 · Payments: Paystack webhook, balance reminders",
  "nodes": [
    {
      "parameters": {
        "content": "## Payments\n**A.** Paystack webhook (signature verified) marks deposit or balance paid and confirms on WhatsApp. Only the webhook changes payment status, never the customer.\n**B.** Every morning, orders due within 48h with a balance get a reminder and pay link.",
        "width": 600,
        "height": 220,
        "color": 4
      },
      "id": "ee0121da-91ab-4d2b-ab80-47f94c7ac7ce",
      "name": "Note 84c6",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -120,
        -320
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "paystack",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "7c55e810-f07c-49a6-99e5-104d0608c674",
      "name": "Webhook: Paystack charge.success",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "0455bacf-7eb4-4181-94f6-8ac817d409d7"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require(\"crypto\");\nconst sig = $json.headers[\"x-paystack-signature\"];\nconst hash = crypto.createHmac(\"sha512\", $vars.PAYSTACK_SECRET).update(JSON.stringify($json.body)).digest(\"hex\");\nif (hash !== sig) return [{ json: { valid: false } }];\nconst d = $json.body.data;\nreturn [{ json: { valid: $json.body.event === \"charge.success\", reference: d.reference, amount_ngn: d.amount / 100, number: d.reference.split(\"-\")[0] + \"-\" + d.reference.split(\"-\")[1], kind: d.reference.endsWith(\"-dep\") ? \"deposit\" : \"balance\" } }];"
      },
      "id": "b6eed23e-1cfd-4768-ab8a-4fbefc1ca9cf",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "963e29c4-96c8-42a8-8894-b2199c54d0f1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "33d450b7-2cd8-4364-93b9-cbd4d2a15117",
      "name": "Valid payment?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: false } }}",
        "options": {}
      },
      "id": "c64aae95-5698-4efa-965d-8afcbf0f214b",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        160
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "orders",
        "returnAll": true,
        "filterType": "string",
        "filterString": "=number=eq.{{ $json.number }}"
      },
      "id": "a15d856b-5cde-4590-80d1-7b3c0073c0f0",
      "name": "Load order",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        720,
        -100
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const p = $(\"Verify signature\").first().json;\nconst paid = Number($json.paid_ngn) + p.amount_ngn;\nreturn [{ json: { id: $json.id, paid_ngn: paid, payment_status: paid >= $json.total_ngn ? \"paid\" : \"deposit\", status: $json.status === \"quoted\" ? \"confirmed\" : $json.status, phone: $json.phone, number: $json.number, balance: Math.max(0, $json.total_ngn - paid) } }];"
      },
      "id": "aae0799e-2891-4c4d-a2ad-4c33951e0412",
      "name": "Apply payment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -100
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "orders",
        "filterType": "string",
        "filterString": "=id=eq.{{ $json.id }}",
        "dataToSend": "autoMapInputData"
      },
      "id": "d719e1cc-3824-45d4-8246-2b76f56a9b66",
      "name": "Update order",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1200,
        -100
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $vars.WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: \"whatsapp\", to: $(\"Apply payment\").first().json.phone, type: \"text\", text: { body: `Payment received, thank you! ${$(\"Apply payment\").first().json.number} is confirmed. ${$(\"Apply payment\").first().json.balance ? \"Balance of ₦\" + $(\"Apply payment\").first().json.balance.toLocaleString() + \" is due before dispatch.\" : \"Paid in full.\"} Track it: https://koretbakes.ng/track/${$(\"Apply payment\").first().json.number}` } }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "3867c8b9-ab75-44cf-b9a4-aa999ed38df9",
      "name": "Confirm on WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        -100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: WhatsApp Cloud API token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true } }}",
        "options": {}
      },
      "id": "ae1aded1-9b0d-4720-9857-335eb59bd82c",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1680,
        -100
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "8108b946-4d1c-45b5-8332-beca34469206",
      "name": "Daily 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        360
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "orders",
        "returnAll": true,
        "filterType": "string",
        "filterString": "=payment_status=eq.deposit&due_date=lte.{{ $now.plus({ days: 2 }).toFormat('yyyy-LL-dd') }}&due_date=gte.{{ $now.toFormat('yyyy-LL-dd') }}"
      },
      "id": "431d8072-b427-45fc-93a3-c199ae785fa8",
      "name": "Balances due in 48h",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        240,
        360
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "b82e52e8-0360-4c78-985e-6372feffc343",
              "leftValue": "={{ $json.id !== undefined }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c2ec76d6-6719-440b-b531-b5201c09cede",
      "name": "Any due?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        360
      ]
    },
    {
      "parameters": {},
      "id": "6e04c78b-2ca1-4c04-9e7e-8b84af861391",
      "name": "No balances due",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        480
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.paystack.co/transaction/initialize",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $json.email || ($json.phone.replace(\"+\", \"\") + \"@wa.koretbakes.ng\"), amount: ($json.total_ngn - $json.paid_ngn) * 100, reference: $json.number + \"-bal\", currency: \"NGN\", callback_url: \"https://koretbakes.ng/track/\" + $json.number + \"-bal\".split(\"-dep\")[0] }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "b5dc42fe-66a2-470e-8305-bd3c5697f007",
      "name": "Paystack: balance link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: Paystack secret key (Authorization: Bearer)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $vars.WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: \"whatsapp\", to: $(\"Balances due in 48h\").item.json.phone, type: \"text\", text: { body: `Hi! Your ${$(\"Balances due in 48h\").item.json.number} is scheduled for ${$(\"Balances due in 48h\").item.json.due_date}. The balance is due before dispatch: ${$json.data.authorization_url}` } }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "583f1e05-c0d2-4fe2-86e9-ac258f224bd2",
      "name": "Balance reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: WhatsApp Cloud API token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Writes one row to automation_events (feeds the dashboard timeline and hours-saved KPI)\nreturn $input.all().map((i) => ({ json: {\n  workflow: \"payment-reminders\",\n  title: \"Balance reminder sent\",\n  contact_id: i.json.contact_id ?? i.json.id ?? null,\n  minutes_saved: 3,\n  at: new Date().toISOString(),\n} }));"
      },
      "id": "f6ef2338-9db5-4800-aea3-5d69879edec2",
      "name": "Log reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    }
  ],
