{
  "name": "10 · Stock levels & supplier re-order",
  "nodes": [
    {
      "parameters": {
        "content": "## Stock\nEach evening: ingredient use from tomorrow's bake sheet (recipes × orders) is deducted from stock. Anything below its re-order level becomes a draft purchase order per supplier; Koret approves on WhatsApp (6h timeout) before it is sent.",
        "width": 600,
        "height": 200,
        "color": 5
      },
      "id": "d2591089-4520-4c08-8676-79518ffb4723",
      "name": "Note fe07",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -120,
        -280
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 18 * * *"
            }
          ]
        }
      },
      "id": "a23d49d7-561e-49ce-adf4-c08458446ced",
      "name": "Daily 18:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "ingredient_levels",
        "returnAll": true,
        "filterType": "string",
        "filterString": "=below_reorder=eq.true"
      },
      "id": "d899d97c-ac2c-4390-8e87-b09c2a0d30ef",
      "name": "Low ingredients",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "4d2fa62b-81eb-4e58-ac3b-e7b75b3c0504",
              "leftValue": "={{ $json.id !== undefined }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6fb01332-653e-4dad-83da-52346724191d",
      "name": "Anything low?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {},
      "id": "0fae206e-cbd2-48d9-82e4-9d1a1efe1902",
      "name": "Stock fine",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "const by = {};\nfor (const { json: i } of $input.all()) { (by[i.supplier_id] ??= { supplier_id: i.supplier_id, supplier_phone: i.supplier_phone, supplier_name: i.supplier_name, lines: [] }).lines.push({ ingredient: i.name, qty: Math.max(i.reorder_qty, i.reorder_level * 2 - i.stock), unit: i.unit, cost_ngn: i.cost_per_unit }); }\nreturn Object.values(by).map((p) => ({ json: { ...p, total_ngn: p.lines.reduce((s, l) => s + l.qty * l.cost_ngn, 0), status: \"draft\" } }));"
      },
      "id": "778d894a-b193-48c8-98bf-5e804f1d470b",
      "name": "Draft POs by supplier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -60
      ]
    },
    {
      "parameters": {
        "tableId": "purchase_orders",
        "dataToSend": "autoMapInputData"
      },
      "id": "b6378de1-f7fe-49cc-94db-3aa422cc92af",
      "name": "Save draft PO",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        960,
        -60
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      }
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "phoneNumberId": "={{ $vars.WA_PHONE_NUMBER_ID }}",
        "recipientPhoneNumber": "={{ $vars.OWNER_WHATSAPP }}",
        "message": "={{ \"Re-order from \" + $json.supplier_name + \": \" + $json.lines.map((l) => l.qty + l.unit + \" \" + l.ingredient).join(\", \") + \". Approve?\" }}",
        "responseType": "approval",
        "options": {
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 6,
              "resumeUnit": "hours"
            }
          }
        }
      },
      "id": "0c990858-34d6-488f-b1ec-a6f6fc355215",
      "name": "Ask Koret to approve (wait 6h)",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        1200,
        -60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: WhatsApp Cloud API token"
        }
      },
      "webhookId": "1e9ea367-6dfe-46bf-97e7-0030e538f265"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "df218e10-f213-4a34-a143-ee7c02d4264d",
              "leftValue": "={{ $json.data.approved }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "8ef6e107-3f81-4f4b-9de0-441a9ea309b0",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1440,
        -60
      ]
    },
    {
      "parameters": {},
      "id": "0aa49e91-42c3-42f5-9074-9db22d92bf3f",
      "name": "Not approved or timed out (stays draft)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1680,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $vars.WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: \"whatsapp\", to: $(\"Save draft PO\").item.json.supplier_phone, type: \"text\", text: { body: \"Hello from Koretbakes. Please deliver: \" + $(\"Save draft PO\").item.json.lines.map((l) => l.qty + l.unit + \" \" + l.ingredient).join(\", \") + \". Thank you!\" } }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "20e63e9f-09ac-4e75-97f4-3235a9eb4605",
      "name": "Send PO to supplier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        -160
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: WhatsApp Cloud API token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "purchase_orders",
        "filterType": "string",
        "filterString": "=id=eq.{{ $(\"Save draft PO\").item.json.id }}",
        "dataToSend": "autoMapInputData"
      },
      "id": "5279ccba-4872-45d5-a2ba-504b418e86a8",
      "name": "Mark PO sent",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1920,
        -160
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      }
    }
  ],
