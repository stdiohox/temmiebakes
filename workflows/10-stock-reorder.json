{
  "name": "10 · Stock levels & supplier re-order",
  "nodes": [
    {
      "parameters": {
        "content": "## Stock\nEach evening: ingredient use from tomorrow's bake sheet (recipes × orders) is deducted from stock. Anything below its re-order level becomes a draft purchase order per supplier; Temmie approves on WhatsApp (6h timeout) before it is sent.",
        "width": 600,
        "height": 200,
        "color": 5
      },
      "id": "1ae14840-0861-4950-b43c-a04fd1c8f758",
      "name": "Note 2264",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -120,
        -280
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 18 * * *"
            }
          ]
        }
      },
      "id": "35547ae2-803f-4fe4-b9e2-17a528ee1e8a",
      "name": "Daily 18:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "ingredient_levels",
        "returnAll": true,
        "filterType": "string",
        "filterString": "=below_reorder=eq.true"
      },
      "id": "acd3ccc9-eb44-4bfd-a38b-ad48e2ee201d",
      "name": "Low ingredients",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "9c38dc9b-020c-45d8-b6b2-3d7f43e59a83",
              "leftValue": "={{ $json.id !== undefined }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9f2b472d-c2d2-4751-bdde-288c68558f72",
      "name": "Anything low?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {},
      "id": "6eee1934-1901-49d6-bf6d-072482f3ad99",
      "name": "Stock fine",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "const by = {};\nfor (const { json: i } of $input.all()) { (by[i.supplier_id] ??= { supplier_id: i.supplier_id, supplier_phone: i.supplier_phone, supplier_name: i.supplier_name, lines: [] }).lines.push({ ingredient: i.name, qty: Math.max(i.reorder_qty, i.reorder_level * 2 - i.stock), unit: i.unit, cost_ngn: i.cost_per_unit }); }\nreturn Object.values(by).map((p) => ({ json: { ...p, total_ngn: p.lines.reduce((s, l) => s + l.qty * l.cost_ngn, 0), status: \"draft\" } }));"
      },
      "id": "7b5b5672-b19c-4aa4-a677-c727b26a8689",
      "name": "Draft POs by supplier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -60
      ]
    },
    {
      "parameters": {
        "tableId": "purchase_orders",
        "dataToSend": "autoMapInputData"
      },
      "id": "2de85d77-c9cc-4e70-b4e2-404ddf875b98",
      "name": "Save draft PO",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        960,
        -60
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      }
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "phoneNumberId": "={{ $vars.WA_PHONE_NUMBER_ID }}",
        "recipientPhoneNumber": "={{ $vars.OWNER_WHATSAPP }}",
        "message": "={{ \"Re-order from \" + $json.supplier_name + \": \" + $json.lines.map((l) => l.qty + l.unit + \" \" + l.ingredient).join(\", \") + \". Approve?\" }}",
        "responseType": "approval",
        "options": {
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 6,
              "resumeUnit": "hours"
            }
          }
        }
      },
      "id": "967ab3ed-866a-4021-9232-5c13bd728ff8",
      "name": "Ask Temmie to approve (wait 6h)",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        1200,
        -60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: WhatsApp Cloud API token"
        }
      },
      "webhookId": "8501ad03-7fd6-460c-9bed-30d7ca014294"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "e705de19-ad73-4749-a6bc-a73f4dbb40db",
              "leftValue": "={{ $json.data.approved }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "8aab8b12-5d50-4384-8e57-9bcfffee9e97",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1440,
        -60
      ]
    },
    {
      "parameters": {},
      "id": "c61b2582-5c8f-49aa-8368-6cbea5ffb887",
      "name": "Not approved or timed out (stays draft)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1680,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $vars.WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: \"whatsapp\", to: $(\"Save draft PO\").item.json.supplier_phone, type: \"text\", text: { body: \"Hello from Koretbakes. Please deliver: \" + $(\"Save draft PO\").item.json.lines.map((l) => l.qty + l.unit + \" \" + l.ingredient).join(\", \") + \". Thank you!\" } }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "3b33bec1-ed50-4f6c-a9e7-000d5d69cfe8",
      "name": "Send PO to supplier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        -160
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: WhatsApp Cloud API token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "purchase_orders",
        "filterType": "string",
        "filterString": "=id=eq.{{ $(\"Save draft PO\").item.json.id }}",
        "dataToSend": "autoMapInputData"
      },
      "id": "0f6b3ffd-869c-42f6-bd94-ff23b2105d88",
      "name": "Mark PO sent",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1920,
        -160
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      }
    }
  ],
