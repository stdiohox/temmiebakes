{
  "name": "05 · Order status updates on WhatsApp",
  "nodes": [
    {
      "parameters": {
        "content": "## Order updates\nFires when the kitchen moves an order (Supabase database webhook on orders.status). Sends a WhatsApp update for baking, ready, out for delivery (with rider and ETA) and delivered, and calls the review request (07) one hour after delivery.",
        "width": 600,
        "height": 200,
        "color": 4
      },
      "id": "3cd044cb-5a75-454c-9a3b-87f974cda25e",
      "name": "Note a09c",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -120,
        -300
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "order-status",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "4f4ce72f-2815-4d7d-afe3-28e762f146bc",
      "name": "Webhook: orders.status changed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "ebbb6013-7aaf-4d8c-b65f-3f73de58b3cc"
    },
    {
      "parameters": {
        "jsCode": "const r = $json.body.record, old = $json.body.old_record ?? {};\nif (r.status === old.status) return [{ json: { skip: true } }];\nconst first = String(r.customer_name ?? \"\").split(\" \")[0] || \"there\";\nconst text = {\n  baking: `Hi ${first}, your ${r.label} is in the oven now 🎂`,\n  ready: r.fulfilment === \"pickup\" ? `Your ${r.label} is ready for pickup at our Ikeja studio.` : `Your ${r.label} is decorated and boxed. A rider will pick it up soon.`,\n  \"out-for-delivery\": `Your ${r.label} is on its way with ${r.rider_name}. ETA about ${r.eta_mins} minutes.`,\n  delivered: `Delivered! Enjoy every bite, ${first}. We'd love a photo 📸`,\n}[r.status];\nreturn [{ json: { skip: !text, status: r.status, phone: r.phone, text, order_id: r.id } }];"
      },
      "id": "b4eebbb0-87b1-4091-ae4e-9d903b6dd757",
      "name": "Build update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "e846d4ce-2778-4684-88fc-d09ada1cd54d",
              "leftValue": "={{ !$json.skip }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0f36fff3-05a9-4b18-9379-e52d8d2c1dfd",
      "name": "Customer-facing status?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {},
      "id": "57479e79-0f8c-4f47-bc5c-cb9293e8a574",
      "name": "Internal status only",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $vars.WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: \"whatsapp\", to: $json.phone, type: \"text\", text: { body: $json.text } }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "c746d842-71a6-44d2-b871-f305258c112f",
      "name": "WhatsApp update",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        -60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: WhatsApp Cloud API token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "74b1398d-e9d9-4739-8a5c-48013b59ba2b",
              "leftValue": "={{ $(\"Build update\").first().json.status === \"delivered\" }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "4a206f57-454f-49c2-abb0-23a94dbc386a",
      "name": "Delivered?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        960,
        -60
      ]
    },
    {
      "parameters": {
        "amount": 1,
        "unit": "hours"
      },
      "id": "37eebc2d-bb8f-4345-8ac5-5f3eda4cbcd6",
      "name": "Wait 1 hour",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1200,
        -160
      ],
      "webhookId": "4706d810-f539-4f72-991d-f2bf03d770f1"
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": "REPLACE_WITH_07_ID",
        "options": {
          "waitForSubWorkflow": false
        }
      },
      "id": "773ff6e8-f116-4fed-bc4a-7e65a83c23ab",
      "name": "Ask for review (07)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        1440,
        -160
      ]
    },
    {
      "parameters": {
        "jsCode": "// Writes one row to automation_events (feeds the dashboard timeline and hours-saved KPI)\nreturn $input.all().map((i) => ({ json: {\n  workflow: \"order-updates\",\n  title: `Customer told: ${$(\"Build update\").first().json.status}`,\n  contact_id: i.json.contact_id ?? i.json.id ?? null,\n  minutes_saved: 2,\n  at: new Date().toISOString(),\n} }));"
      },
      "id": "2c7d359e-474c-4d02-8df9-2beeb73e1ddb",
      "name": "Log update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        40
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true } }}",
        "options": {}
      },
      "id": "9a3c2737-f51a-4e0a-9c9a-3b023ae75b1b",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1440,
        40
      ]
    }
  ],
