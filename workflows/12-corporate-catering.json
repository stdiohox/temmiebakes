{
  "name": "12 · Corporate catering quotes & proposals",
  "nodes": [
    {
      "parameters": {
        "content": "## Corporate\nCompany enquiry (website form or Tia) → package priced per guest → Claude writes a short proposal from the approved package copy → PDF-ready HTML emailed to the client and logged as *sent*. A 3-day follow-up runs if there's no answer.",
        "width": 600,
        "height": 200,
        "color": 5
      },
      "id": "3ab10d73-66ef-417f-a87d-727b679c333f",
      "name": "Note 572e",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -120,
        -280
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "corporate",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "dbba24ed-3551-4223-998a-103d2cbd2cee",
      "name": "Webhook: corporate enquiry",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "ecf42ecf-da84-4dcb-9483-a4e08bf22fef"
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body;\nconst PER_GUEST = { \"breakfast-box\": 7500, \"canape-reception\": 11000, \"dessert-table\": 9000, \"cake-and-cupcakes\": 4500 };\nif (!PER_GUEST[b.package_id]) return [{ json: { ...b, valid: false } }];\nconst guests = Math.max(10, Number(b.guests) || 0);\nconst total = PER_GUEST[b.package_id] * guests + (guests > 100 ? 0 : 15000);\nreturn [{ json: { ...b, guests, per_guest_ngn: PER_GUEST[b.package_id], total_ngn: total, valid: true } }];"
      },
      "id": "263c54bf-fe2b-4a68-bf4e-d59f694c886c",
      "name": "Price package",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "91ee696f-02f3-471a-973e-46bd1f38132d",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9af59ca4-80c1-47fd-98e6-5f81870b5488",
      "name": "Known package?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: false, error: \"unknown package\" } }}",
        "options": {}
      },
      "id": "ef6d7b3d-44ba-460d-9fac-7a32c259619f",
      "name": "Respond 422",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"claude-sonnet-5-5\", max_tokens: 700, temperature: 0.5, system: \"Write a concise catering proposal (under 160 words) from Koretbakes, Lagos, for the event described. Use ONLY the figures given. British English, no em dashes. Terms: 50% deposit to confirm, balance 48 hours before the event.\", messages: [{ role: \"user\", content: JSON.stringify($json) }] }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "55530f93-d4b4-44ff-97d9-e721ea7e6aa4",
      "name": "Claude: proposal text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        -60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: Anthropic API key (x-api-key)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const t = $json.content?.[0]?.text ?? \"\";\nconst q = $(\"Price package\").first().json;\nconst ok = t.includes(q.total_ngn.toLocaleString(\"en-GB\")) || t.includes(String(q.total_ngn));\nreturn [{ json: { ...q, proposal: t, needs_review: !ok || /—|–/.test(t) } }];"
      },
      "id": "17a105a3-5fc1-4419-ad93-df90a7cdd730",
      "name": "Validate proposal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -60
      ]
    },
