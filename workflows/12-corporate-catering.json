{
  "name": "12 · Corporate catering quotes & proposals",
  "nodes": [
    {
      "parameters": {
        "content": "## Corporate\nCompany enquiry (website form or Tia) → package priced per guest → Claude writes a short proposal from the approved package copy → PDF-ready HTML emailed to the client and logged as *sent*. A 3-day follow-up runs if there's no answer.",
        "width": 600,
        "height": 200,
        "color": 5
      },
      "id": "962ae746-8cc2-4d2b-b518-5d44f6a60a74",
      "name": "Note 63ab",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -120,
        -280
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "corporate",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "9046242a-fe2d-4f07-b792-e7c3177844c6",
      "name": "Webhook: corporate enquiry",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "fdb3ed75-9748-4140-93cb-918d3736b650"
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body;\nconst PER_GUEST = { \"breakfast-box\": 7500, \"canape-reception\": 11000, \"dessert-table\": 9000, \"cake-and-cupcakes\": 4500 };\nif (!PER_GUEST[b.package_id]) return [{ json: { ...b, valid: false } }];\nconst guests = Math.max(10, Number(b.guests) || 0);\nconst total = PER_GUEST[b.package_id] * guests + (guests > 100 ? 0 : 15000);\nreturn [{ json: { ...b, guests, per_guest_ngn: PER_GUEST[b.package_id], total_ngn: total, valid: true } }];"
      },
      "id": "71cb996a-352a-45db-8810-12b96919a19d",
      "name": "Price package",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "78ca2251-16cf-4b3f-94cb-6ac5edd6cce6",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f84e106b-54fe-4441-a01f-86177a70b7ea",
      "name": "Known package?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: false, error: \"unknown package\" } }}",
        "options": {}
      },
      "id": "1ad73cc1-8bf1-4762-8411-33c40746a89a",
      "name": "Respond 422",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"claude-sonnet-5-5\", max_tokens: 700, temperature: 0.5, system: \"Write a concise catering proposal (under 160 words) from Temmiebakes, Lagos, for the event described. Use ONLY the figures given. British English, no em dashes. Terms: 50% deposit to confirm, balance 48 hours before the event.\", messages: [{ role: \"user\", content: JSON.stringify($json) }] }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "add4e9b5-cb64-4787-b754-a33187eeda09",
      "name": "Claude: proposal text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        -60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: Anthropic API key (x-api-key)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const t = $json.content?.[0]?.text ?? \"\";\nconst q = $(\"Price package\").first().json;\nconst ok = t.includes(q.total_ngn.toLocaleString(\"en-GB\")) || t.includes(String(q.total_ngn));\nreturn [{ json: { ...q, proposal: t, needs_review: !ok || /—|–/.test(t) } }];"
      },
      "id": "288e0dec-5746-4eb3-80f7-861776a937dd",
      "name": "Validate proposal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -60
      ]
    },
