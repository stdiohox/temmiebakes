{
  "name": "12 · Corporate catering quotes & proposals",
  "nodes": [
    {
      "parameters": {
        "content": "## Corporate\nCompany enquiry (website form or Tia) → package priced per guest → Claude writes a short proposal from the approved package copy → PDF-ready HTML emailed to the client and logged as *sent*. A 3-day follow-up runs if there's no answer.",
        "width": 600,
        "height": 200,
        "color": 5
      },
      "id": "3b86be83-d258-4174-aa8a-e2ce2a65b47b",
      "name": "Note 1ef2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -120,
        -280
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "corporate",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "15e53340-c2be-47c5-af72-a269da110afe",
      "name": "Webhook: corporate enquiry",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "82a3d2c2-20a1-454d-8bca-ddf7c9700d0d"
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body;\nconst PER_GUEST = { \"breakfast-box\": 7500, \"canape-reception\": 11000, \"dessert-table\": 9000, \"cake-and-cupcakes\": 4500 };\nif (!PER_GUEST[b.package_id]) return [{ json: { ...b, valid: false } }];\nconst guests = Math.max(10, Number(b.guests) || 0);\nconst total = PER_GUEST[b.package_id] * guests + (guests > 100 ? 0 : 15000);\nreturn [{ json: { ...b, guests, per_guest_ngn: PER_GUEST[b.package_id], total_ngn: total, valid: true } }];"
      },
      "id": "b769791d-175b-476e-ada9-0c27f90923e5",
      "name": "Price package",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "a1263a35-8ca9-469b-af24-9e4a994dca50",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "300f6e71-e618-48d8-af73-4b4b1009a3cd",
      "name": "Known package?",
