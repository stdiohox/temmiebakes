        "responseMode": "responseNode",
        "options": {}
      },
      "id": "fece6c03-4def-4ffe-9338-fdc0248bb5e0",
      "name": "Webhook: class booking (website, Tia)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "6ee18535-762b-4838-bf5b-86e35afb2416"
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "cohorts",
        "returnAll": true,
        "filterType": "string",
        "filterString": "=id=eq.{{ $json.body.cohort_id }}"
      },
      "id": "e5341cc2-ce22-4cde-a53a-0ee7bf25687e",
      "name": "Load cohort",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "0abcad0d-9a5e-4bc2-8c44-9ace7faec887",
              "leftValue": "={{ $json.seats_taken < $json.seats }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d93ec600-5180-4ba2-81b8-44461e5aa547",
      "name": "Seat available?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ...$(\"Webhook: class booking (website, Tia)\").first().json.body, status: \"waitlist\" } }];"
      },
      "id": "64aaedd8-b78b-494e-a611-dc5499aacf65",
      "name": "Waitlist",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        140
      ]
    },
    {
      "parameters": {
        "tableId": "enrollments",
        "dataToSend": "autoMapInputData"
      },
      "id": "d3ad8a61-bf82-43b5-b26a-0cfa4527113e",
      "name": "Add to waitlist",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        960,
        140
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, waitlist: true } }}",
        "options": {}
      },
      "id": "4eb00358-bf61-4a49-825b-645049b6d893",
      "name": "Respond: waitlisted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $(\"Webhook: class booking (website, Tia)\").first().json.body;\nreturn [{ json: { cohort_id: b.cohort_id, customer_id: b.customer_id, phone: b.phone, status: \"reserved\", deposit_ngn: Math.round($(\"Load cohort\").first().json.price_ngn / 2) } }];"
      },
      "id": "821b4f2a-631f-42c9-aaf8-f223b9d641fb",
      "name": "Enrolment row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -60
      ]
    },
    {
      "parameters": {
        "tableId": "enrollments",
        "dataToSend": "autoMapInputData"
      },
      "id": "0182fd58-10a3-42f9-8563-bc3ef2caecd9",
      "name": "Reserve seat",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        960,
        -60
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.paystack.co/transaction/initialize",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $json.phone.replace(\"+\", \"\") + \"@wa.koretbakes.ng\", amount: $json.deposit_ngn * 100, reference: \"AC-\" + $json.id + \"-dep\", currency: \"NGN\", callback_url: \"https://koretbakes.ng/track/\" + \"AC-\" + $json.id + \"-dep\".split(\"-dep\")[0] }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "feddb42c-b6c2-4910-a7de-f54c80a0f040",
      "name": "Paystack: class deposit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        -60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: Paystack secret key (Authorization: Bearer)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $vars.WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: \"whatsapp\", to: $(\"Enrolment row\").first().json.phone, type: \"text\", text: { body: `Your seat is reserved! Pay the 50% deposit to confirm: ${$json.data.authorization_url}. We send the kit list a week before class.` } }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "a06d164a-7ed8-419f-9ecd-e2a34ef3b4aa",
      "name": "Send seat + pay link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        -60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: WhatsApp Cloud API token"
        }
      },
