{
  "name": "11 · Academy: class enquiries, seat booking, reminders, certificates",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "academy/book",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "75d196a0-c3f3-4bb4-8462-5bd53e694f88",
      "name": "Webhook: class booking (website, Tia)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "e3abc76c-f163-458c-9aad-a7e771f17f73"
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "cohorts",
        "returnAll": true,
        "filterType": "string",
        "filterString": "=id=eq.{{ $json.body.cohort_id }}"
      },
      "id": "9c32dff6-f015-4447-bce0-94ea93534a18",
      "name": "Load cohort",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "bc8744f6-eac1-434b-9275-e954c5255bda",
              "leftValue": "={{ $json.seats_taken < $json.seats }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c48fa595-d8a6-4b98-b512-64400fd6f399",
      "name": "Seat available?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ...$(\"Webhook: class booking (website, Tia)\").first().json.body, status: \"waitlist\" } }];"
      },
      "id": "f2b6b2e9-59e4-4029-982c-86af0d2d82ef",
      "name": "Waitlist",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        140
      ]
    },
    {
      "parameters": {
        "tableId": "enrollments",
        "dataToSend": "autoMapInputData"
      },
      "id": "1a736da1-c180-4a11-b88e-dd7836b672a6",
      "name": "Add to waitlist",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        960,
        140
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, waitlist: true } }}",
        "options": {}
      },
      "id": "c7ef5f21-dd4a-4699-8118-153532311d7a",
      "name": "Respond: waitlisted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $(\"Webhook: class booking (website, Tia)\").first().json.body;\nreturn [{ json: { cohort_id: b.cohort_id, customer_id: b.customer_id, phone: b.phone, status: \"reserved\", deposit_ngn: Math.round($(\"Load cohort\").first().json.price_ngn / 2) } }];"
      },
      "id": "2145700a-7062-482c-a038-7ec5f818d311",
      "name": "Enrolment row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -60
      ]
    },
    {
      "parameters": {
        "tableId": "enrollments",
        "dataToSend": "autoMapInputData"
      },
      "id": "cf1f2cdb-430c-42ae-b873-f35d34105a8f",
      "name": "Reserve seat",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        960,
        -60
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.paystack.co/transaction/initialize",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $json.phone.replace(\"+\", \"\") + \"@wa.koretbakes.ng\", amount: $json.deposit_ngn * 100, reference: \"AC-\" + $json.id + \"-dep\", currency: \"NGN\", callback_url: \"https://koretbakes.ng/track/\" + \"AC-\" + $json.id + \"-dep\".split(\"-dep\")[0] }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "bf36e44e-3e26-495f-8579-271c295537a0",
      "name": "Paystack: class deposit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        -60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: Paystack secret key (Authorization: Bearer)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $vars.WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: \"whatsapp\", to: $(\"Enrolment row\").first().json.phone, type: \"text\", text: { body: `Your seat is reserved! Pay the 50% deposit to confirm: ${$json.data.authorization_url}. We send the kit list a week before class.` } }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "2f3e90d0-4944-4ff1-844f-df80ff8d2ba9",
      "name": "Send seat + pay link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        -60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: WhatsApp Cloud API token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true } }}",
        "options": {}
      },
      "id": "82ec6a2d-d499-42db-8d9f-450bd331c162",
