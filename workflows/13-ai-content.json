{
  "name": "13 · AI content drafts (Instagram posts, reels, broadcasts)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * 1,4"
            }
          ]
        }
      },
      "id": "134d7123-b299-465c-857a-b3335025b596",
      "name": "Mon & Thu 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "content_inputs",
        "returnAll": true,
        "filterType": "string",
        "filterString": "=week=eq.{{ $now.toFormat('kkkk-WW') }}"
      },
      "id": "f548ca12-c334-4ee4-9ce6-5afa26ae0659",
      "name": "Best sellers & new items",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"claude-sonnet-5-5\", max_tokens: 1500, temperature: 0.8, system: \"You write Instagram captions, reel scripts and WhatsApp broadcasts for Koretbakes, a Lagos cake and dessert business. Warm, playful, British English, no em dashes. Include price, lead time and the call to action DM CAKE. 5-6 Lagos hashtags. Return ONLY JSON: {\\\"drafts\\\":[{\\\"kind\\\":\\\"instagram-post|reel-script|whatsapp-broadcast\\\",\\\"product\\\":string,\\\"text\\\":string}]}\", messages: [{ role: \"user\", content: JSON.stringify($input.all().map((i) => i.json)) }] }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "fbb6067a-ccbb-4d5b-8fa4-7988eacc4aed",
      "name": "Claude: write drafts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: Anthropic API key (x-api-key)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Parse model JSON and validate. Anomalies are FLAGGED for review, never silently defaulted.\nconst out = [];\nfor (const item of $input.all()) {\n  const raw = item.json.content?.[0]?.text;\n  let parsed = null, anomaly = null;\n  try {\n    const text = String(raw ?? \"\").replace(/^\\s*```(json)?/i, \"\").replace(/```\\s*$/, \"\").trim();\n    parsed = JSON.parse(text);\n  } catch (e) {\n    anomaly = \"AI output was not valid JSON\";\n  }\n  const missing = parsed ? [\"drafts\"].filter((k) => !(k in parsed)) : [];\n  if (!anomaly && missing.length) anomaly = \"AI output missing fields: \" + missing.join(\", \");\n  out.push({ json: { ...item.json, ai: parsed ?? {}, ai_anomaly: anomaly, needs_review: Boolean(anomaly) } });\n}\nreturn out;"
      },
      "id": "5ab37052-09cf-4ed8-bfe8-0650ec05a490",
      "name": "Validate drafts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "0c882213-6bdf-470b-ad58-2c649d14a50d",
              "leftValue": "={{ !$json.needs_review }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1ab20527-e7a1-41f2-b104-1fad4a733296",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $vars.WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: \"whatsapp\", to: $vars.OWNER_WHATSAPP, type: \"text\", text: { body: \"This week's AI drafts did not come out right, please check the content page.\" } }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "75196bce-aba4-401f-9bfd-0f05927f99cc",
      "name": "Tell Temmie drafts failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        140
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: WhatsApp Cloud API token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "return $json.ai.drafts.map((d) => ({ json: { ...d, status: \"awaiting-approval\", text: d.text.replace(/[—–]/g, \",\") } }));"
      },
      "id": "82435b8e-f114-42f2-9625-4f04520ccfff",
      "name": "One row per draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        -60
      ]
    },
    {
      "parameters": {
        "tableId": "content_drafts",
        "dataToSend": "autoMapInputData"
      },
      "id": "fcd6918b-7629-44ea-b070-4937c8240383",
      "name": "Save to approval queue",
