        "jsonBody": "={{ JSON.stringify({ model: \"claude-sonnet-5-5\", max_tokens: 400, temperature: 0.5, system: \"You are Tia, the AI assistant for Koretbakes, a cake and dessert business in Ikeja, Lagos. Be warm and brief, 1-3 sentences, British English, no em dashes. Say you are an AI in the first reply. Quote ONLY prices from the price book provided. Never promise discounts or same-day orders. If details are missing ask for at most two of: \" + $(\"Merge draft & apply handoff rules\").first().json.missing.join(\", \"), messages: [{ role: \"user\", content: \"Knowledge: \" + JSON.stringify($input.all().map((i) => i.json)) + \"\\nDraft: \" + JSON.stringify($(\"Merge draft & apply handoff rules\").first().json.draft) + \"\\nCustomer: \" + $(\"Merge draft & apply handoff rules\").first().json.text }] }) }}",
