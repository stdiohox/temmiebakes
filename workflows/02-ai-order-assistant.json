    },
    {
      "parameters": {
        "jsCode": "// Block replies that invent prices or promise discounts; send them to Temmie instead.\nconst text = $json.content?.[0]?.text ?? \"\";\nconst book = $(\"Approved knowledge & price book\").all().map((i) => JSON.stringify(i.json)).join(\" \");\nconst prices = (text.match(/₦\\s?[\\d,]+/g) ?? []).map((p) => p.replace(/[^\\d]/g, \"\"));\nconst invented = prices.filter((p) => !book.includes(p));\nconst bad = !text || /discount|free cake|guarantee/i.test(text) || invented.length > 0 || /—|–/.test(text);\nreturn [{ json: { ...$(\"Merge draft & apply handoff rules\").first().json, reply: bad ? null : text, status: bad ? \"handoff\" : \"ai\", guard_reason: bad ? (invented.length ? \"Price not in price book: \" + invented.join(\", \") : \"Reply failed guardrail\") : null } }];"
      },
