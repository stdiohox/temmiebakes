      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: `You read DMs for a Lagos cake business. Messages may be in Nigerian Pidgin. Return ONLY JSON: {\"intent\":\"order|price|menu|class|corporate|track|complaint|discount|human|wedding|other\",\"size_inches\":number|null,\"tiers\":number|null,\"flavour\":string|null,\"product\":string|null,\"qty\":number|null,\"date\":\"YYYY-MM-DD\"|null,\"area\":string|null,\"guests\":number|null,\"name\":string|null,\"phone\":string|null,\"order_number\":string|null}. Do not use \\`\\`\\`json. Output must start with { and end with }.\\nToday: ${$now.toFormat(\"yyyy-LL-dd\")}\\nMessage: ${$(\"Normalise message\").first().json.text}` }] }], generationConfig: { temperature: 0.1, maxOutputTokens: 256, responseMimeType: \"application/json\" } }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "51292053-f52f-4884-a3d9-595666d1ef90",
      "name": "Gemini: classify & extract",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        260
      ],
      "credentials": {
        "httpQueryAuth": {
          "id": "REPLACE",
          "name": "REPLACE: Gemini API key (?key=)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Parse model JSON and validate. Anomalies are FLAGGED for review, never silently defaulted.\nconst out = [];\nfor (const item of $input.all()) {\n  const raw = item.json.candidates?.[0]?.content?.parts?.[0]?.text;\n  let parsed = null, anomaly = null;\n  try {\n    const text = String(raw ?? \"\").replace(/^\\s*```(json)?/i, \"\").replace(/```\\s*$/, \"\").trim();\n    parsed = JSON.parse(text);\n  } catch (e) {\n    anomaly = \"AI output was not valid JSON\";\n  }\n  const missing = parsed ? [\"intent\"].filter((k) => !(k in parsed)) : [];\n  if (!anomaly && missing.length) anomaly = \"AI output missing fields: \" + missing.join(\", \");\n  out.push({ json: { ...item.json, ai: parsed ?? {}, ai_anomaly: anomaly, needs_review: Boolean(anomaly) } });\n}\nreturn out;"
      },
      "id": "fd334587-c794-4268-a340-e133046db41e",
      "name": "Validate classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const draft = { ...($(\"Load conversation & draft\").first().json.draft ?? {}) };\nconst a = $json.ai ?? {};\nfor (const [k, val] of Object.entries(a)) if (val !== null && k !== \"intent\") draft[k] = val;\nconst settings = $vars.TIA_HANDOFF ? JSON.parse($vars.TIA_HANDOFF) : [];\nconst text = $(\"Normalise message\").first().json.text.toLowerCase();\nconst hit = settings.find((h) => h.enabled && h.keywords.some((k) => text.includes(k)));\nconst handoff = $json.needs_review ? \"Could not understand the message\" : hit?.label ?? ([\"complaint\", \"discount\", \"human\", \"wedding\"].includes(a.intent) ? a.intent : null);\nconst missing = [\"size_inches\", \"flavour\", \"date\", \"area\", \"name\", \"phone\"].filter((k) => a.intent === \"order\" && !draft[k]);\nreturn [{ json: { ...$(\"Normalise message\").first().json, intent: a.intent ?? \"other\", draft, handoff, missing, ready: a.intent === \"order\" && missing.length === 0 } }];"
      },
