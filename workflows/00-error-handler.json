{
  "name": "00 · Error handler (all workflows)",
  "nodes": [
    {
      "parameters": {
        "content": "## Error handler\nSet as **errorWorkflow** on every Koretbakes workflow.\nLogs the failure to Supabase and WhatsApps Koret the failing node and execution link, so an order never silently drops.",
        "width": 460,
        "height": 200,
        "color": 3
      },
      "id": "ea06711b-ca81-47db-905b-dac6917de2d2",
      "name": "Note c0ea",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -260
      ]
    },
    {
      "parameters": {},
      "id": "dca7688a-5377-467d-a2dd-3042adcdbac3",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $json.execution ?? {};\nreturn [{ json: { workflow: $json.workflow?.name, node: e.lastNodeExecuted, message: e.error?.message ?? \"Unknown error\", url: e.url, at: new Date().toISOString() } }];"
      },
      "id": "3ef6cc5e-0333-4a88-8e4d-df6e5f051644",
      "name": "Format failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "tableId": "automation_errors",
        "dataToSend": "autoMapInputData"
      },
      "id": "3583b8f9-53d9-43a0-81ee-63fb4ffbf902",
      "name": "Log to automation_errors",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        480,
        -100
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $vars.WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: \"whatsapp\", to: $vars.OWNER_WHATSAPP, type: \"text\", text: { body: `Automation failed: ${$json.workflow}\\nNode: ${$json.node}\\n${$json.message}\\n${$json.url}` } }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "a0ee19a1-e462-46b1-99a1-abe2232fcad4",
      "name": "Alert Koret",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: WhatsApp Cloud API token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Format failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format failure": {
      "main": [
        [
          {
            "node": "Log to automation_errors",
            "type": "main",
            "index": 0
          },
          {
            "node": "Alert Koret",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Africa/Lagos",
    "saveManualExecutions": true
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [
    {
      "name": "koretbakes"
    },
    {
      "name": "ops"
    }
  ]
}
