{
  "name": "01 · Order intake: website, Instagram, WhatsApp",
  "nodes": [
    {
      "parameters": {
        "content": "## Order intake\nOne entry point for the **website checkout, cake builder and Tia's confirmed orders**.\nNormalise → find or create customer (phone / Instagram handle) → price from the menu and cake rules → **capacity check** (oven points per day) → create order as *quoted* → Paystack deposit link → WhatsApp quote → schedule the 6h follow-up (03).",
        "width": 640,
        "height": 220,
        "color": 4
      },
      "id": "287d3c9d-02d4-4fd3-b4bb-3df5d99eed6c",
      "name": "Note 4c5d",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -120,
        -340
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "order",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "92dc0224-37aa-4ce2-808e-6a807b146e55",
      "name": "Webhook: checkout, cake builder, Tia",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "0adeb82f-5b64-4aa5-b388-496e01105485"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(({ json: j }) => {\n  const b = j.body ?? {};\n  let phone = String(b.phone ?? \"\").replace(/[^\\d+]/g, \"\");\n  if (/^0\\d{10}$/.test(phone)) phone = \"+234\" + phone.slice(1);\n  return { json: { source: b.source ?? \"web\", name: String(b.name ?? \"\").trim(), phone, instagram: b.instagram ?? null, email: b.email ?? null,\n    items: b.items ?? [], cake: b.cake ?? null, due_date: b.due_date, due_time: b.due_time ?? \"14:00\", fulfilment: b.fulfilment ?? \"delivery\",\n    zone_id: b.zone_id ?? null, address: b.address ?? null, occasion: b.occasion ?? null, message_on_cake: b.message_on_cake ?? null, received_at: new Date().toISOString() } };\n});"
      },
      "id": "14536a3f-678b-4871-aae0-0d5c41cf7e1c",
      "name": "Normalise order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "8b055c62-a33b-44a1-afe6-da6624f918e8",
              "leftValue": "={{ Boolean($json.phone && $json.due_date && ($json.items.length || $json.cake)) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
