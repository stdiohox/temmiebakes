            {
              "id": "5beaf2af-d3be-4a67-947e-e89cabdb2eef",
              "leftValue": "={{ $json.fits && $json.lead_ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
