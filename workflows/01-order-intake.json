    {
      "parameters": {
        "operation": "getAll",
        "tableId": "customers",
        "returnAll": true,
        "filterType": "string",
        "filterString": "=or=(phone.eq.{{ $json.phone }},instagram.eq.{{ $json.instagram || \"none\" }})"
      },
