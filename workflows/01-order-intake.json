              "id": "dba5aab9-8a37-4aa9-8d46-6ef7cd360c8d",
              "leftValue": "={{ $json.fits && $json.lead_ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
