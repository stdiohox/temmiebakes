    {
      "parameters": {
        "operation": "getAll",
        "tableId": "price_book",
        "returnAll": true,
        "filterType": "string",
        "filterString": "=active=eq.true"
      },
      "id": "f724b2e9-d219-4076-b410-9e15c33d891e",
      "name": "Load menu, cake rules, zones",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1440,
        -100
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Same rules as the website: size base + tiers + flavour/filling/finish/decoration extras, zone delivery fee\nconst book = Object.fromEntries($input.all().map((i) => [i.json.key, i.json]));\nconst o = $(\"Normalise order\").first().json;\nlet subtotal = 0, oven_points = 0, lead_days = 1;\nfor (const it of o.items) { const p = book[\"product:\" + it.product_id]; if (!p) throw new Error(\"Unknown product \" + it.product_id); subtotal += p.price_ngn * it.qty; oven_points += p.oven_points * it.qty; lead_days = Math.max(lead_days, p.lead_days); }\nif (o.cake) {\n  const c = o.cake; const base = book[\"size:\" + c.size_inches]?.price_ngn;\n  if (!base) throw new Error(\"Unsupported cake size \" + c.size_inches);\n  const tierMult = [0, 1, 1.85, 2.6, 3.3][c.tiers ?? 1];\n  subtotal += Math.round((base * tierMult + (book[\"flavour:\" + c.flavour]?.price_ngn ?? 0) + (book[\"filling:\" + c.filling]?.price_ngn ?? 0) + (book[\"finish:\" + c.finish]?.price_ngn ?? 0) + (book[\"decoration:\" + c.decoration]?.price_ngn ?? 0)) / 500) * 500;\n  oven_points += (c.tiers ?? 1) * 2 + (c.size_inches >= 10 ? 1 : 0); lead_days = Math.max(lead_days, c.tiers > 1 ? 4 : 2);\n}\nconst delivery = o.fulfilment === \"delivery\" ? (book[\"zone:\" + o.zone_id]?.price_ngn ?? null) : 0;\nif (delivery === null) throw new Error(\"Unknown delivery zone \" + o.zone_id);\nconst daysAhead = (new Date(o.due_date) - new Date(new Date().toISOString().slice(0, 10))) / 86400000;\nreturn [{ json: { ...o, customer_id: $(\"Upsert customer\").first().json.id, subtotal_ngn: subtotal, delivery_ngn: delivery, total_ngn: subtotal + delivery, deposit_ngn: Math.ceil((subtotal + delivery) * 0.5 / 100) * 100, oven_points, lead_days, lead_ok: daysAhead >= lead_days } }];"
      },
      "id": "84e4cfdb-7f15-43d3-9bbe-d37eee1b6412",
      "name": "Price the order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        -100
      ]
    },
