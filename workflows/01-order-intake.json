    {
      "parameters": {
        "jsCode": "const cap = Number($vars.DAILY_OVEN_POINTS ?? 20);\nconst booked = $input.all().reduce((s, i) => s + Number(i.json.oven_points ?? 0), 0);\nconst want = Number($(\"Price the order\").first().json.oven_points ?? 1);\nconst day = $(\"Price the order\").first().json.due_date;\nconst sunday = new Date(day + \"T12:00:00Z\").getUTCDay() === 0;\nreturn [{ json: { ...$(\"Price the order\").first().json, booked, capacity: cap, fits: !sunday && booked + want <= cap, reason: sunday ? \"Closed on Sundays\" : booked + want > cap ? \"Kitchen full that day\" : null } }];"
      },
      "id": "1b1ad240-ccea-4784-9d39-a3ffdf9f1d1f",
      "name": "Capacity check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        -100
      ]
    },
