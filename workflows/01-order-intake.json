      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: false, error: \"phone, items and due date are required\" } }}",
        "options": {}
      },
      "id": "66725456-d5a4-4995-a1ca-c2dec3ea0932",
      "name": "Respond 422: missing details",
      "type": "n8n-nodes-base.respondToWebhook",
