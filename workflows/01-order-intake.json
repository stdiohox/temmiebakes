    {
      "parameters": {
        "jsCode": "const o = $(\"Normalise order\").first().json;\nconst c = $input.all().map((i) => i.json).find((x) => x.id);\nreturn [{ json: { id: c?.id, name: c?.name ?? o.name, phone: o.phone, instagram: c?.instagram ?? o.instagram, zone_id: o.zone_id ?? c?.zone_id, source: c?.source ?? o.source, is_new: !c } }];"
      },
      "id": "83bf373f-9bb4-40e2-bf0d-517f9f392702",
      "name": "Customer upsert payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -100
      ]
    },
    {
      "parameters": {
