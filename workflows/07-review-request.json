      "name": "Parse rating",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "f7f8a421-a400-4e8f-a6db-d9fbb1f31960",
                    "leftValue": "={{ !$json.answered ? \"none\" : $json.rating >= 4 ? \"happy\" : $json.rating ? \"unhappy\" : \"unclear\" }}",
                    "rightValue": "happy",
                    "operator": {
