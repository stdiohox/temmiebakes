      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "phoneNumberId": "={{ $vars.WA_PHONE_NUMBER_ID }}",
        "recipientPhoneNumber": "={{ $json.phone }}",
        "message": "How was your order? Reply with a number from 1 (poor) to 5 (perfect).",
        "responseType": "freeText",
        "options": {
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 6,
              "resumeUnit": "hours"
            }
          }
        }
      },
      "id": "1b8666de-f316-40f6-a83b-249de007e0b6",
      "name": "Ask for rating (WhatsApp, wait 6h)",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: WhatsApp Cloud API token"
        }
      },
      "webhookId": "f2bfe4bb-cb21-41e0-87b9-92f7475468bc"
    },
    {
      "parameters": {
        "jsCode": "const raw = String($json.data?.text ?? \"\");\nconst n = Number((raw.match(/[1-5]/) ?? [])[0]);\nreturn [{ json: { order_id: $(\"Called by order updates (05)\").first().json.order_id, phone: $(\"Called by order updates (05)\").first().json.phone, rating: n || null, comment: raw, answered: Boolean(raw) } }];"
      },
      "id": "63434028-4173-4793-bb00-16f9cad2eb4d",
      "name": "Parse rating",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "0bc30b76-513f-4326-acd7-5950b37be970",
                    "leftValue": "={{ !$json.answered ? \"none\" : $json.rating >= 4 ? \"happy\" : $json.rating ? \"unhappy\" : \"unclear\" }}",
                    "rightValue": "happy",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "happy"
            },
