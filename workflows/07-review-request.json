{
  "name": "07 · Review request & low-rating rescue",
  "nodes": [
    {
      "parameters": {
        "content": "## Reviews\nCalled an hour after delivery. Asks for a 1-5 rating on WhatsApp (6h timeout). 4-5 stars: thank you + Google review link. 1-3 stars: Gemini summarises the issue, Temmie is alerted and the customer hears back personally. Never auto-replies to a complaint.",
        "width": 620,
        "height": 200,
        "color": 5
      },
      "id": "f007b642-d7b4-46f1-adc7-5b4ee958fcd5",
      "name": "Note c041",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -120,
        -300
      ]
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
