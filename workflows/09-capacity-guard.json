{
  "name": "09 · Kitchen capacity guard",
  "nodes": [
    {
      "parameters": {
        "content": "## Capacity guard\nEvery 2 hours: oven points booked per day for the next 7 days. Days at 90%+ are marked full so Tia and the website offer the next free date, and Koret gets one alert per day.",
        "width": 560,
        "height": 180,
        "color": 5
      },
      "id": "580e9127-0c34-4f8b-bf76-1b3d6c651039",
      "name": "Note a8d2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -120,
        -260
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      },
      "id": "b13edc7a-6e49-490b-a768-8f0fc13a2831",
      "name": "Every 2 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "capacity_by_day",
        "returnAll": true,
        "filterType": "string",
        "filterString": "=day=gte.{{ $now.toFormat('yyyy-LL-dd') }}&day=lte.{{ $now.plus({ days: 7 }).toFormat('yyyy-LL-dd') }}"
      },
      "id": "bb28fefc-2dcd-4dd0-87b4-8b0d33f9e620",
      "name": "Points booked, next 7 days",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const cap = Number($vars.DAILY_OVEN_POINTS ?? 20);\nconst full = $input.all().map((i) => i.json).filter((d) => d.points >= cap * 0.9);\nreturn [{ json: { full_days: full.map((d) => d.day), any: full.length > 0 } }];"
      },
      "id": "a2050ef9-a363-4bcb-914e-84f9aedd6005",
      "name": "Find full days",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "33e21c51-ccab-4f48-825c-38e20bab99ce",
              "leftValue": "={{ $json.any }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9692ccab-35f2-4996-9889-0f9851daa318",
      "name": "Any day nearly full?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {},
      "id": "cf0a9882-2201-4a3c-aebe-093974212d0c",
      "name": "Room every day",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        960,
        140
      ]
    },
    {
      "parameters": {
        "operation": "upsert",
        "tableId": "blocked_days",
        "dataToSend": "autoMapInputData"
      },
      "id": "88826c1a-7f01-4260-984b-99e25d20a4ab",
      "name": "Mark days full",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        960,
        -60
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE",
          "name": "REPLACE: Supabase (Koretbakes)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $vars.WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: \"whatsapp\", to: $vars.OWNER_WHATSAPP, type: \"text\", text: { body: `Kitchen nearly full on ${$(\"Find full days\").first().json.full_days.join(\", \")}. Tia is offering the next free dates.` } }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "083d48c6-6dc9-405e-a64d-25cbe7cc3a50",
      "name": "Tell Koret",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        -60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "REPLACE: WhatsApp Cloud API token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
